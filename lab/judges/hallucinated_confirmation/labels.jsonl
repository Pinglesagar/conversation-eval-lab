{"item_id": "waitlist-offer", "label": "pass", "labeller": "repo-owner (single labeller; no second-rater agreement measured)", "note": "Offers the waitlist. An offer is not a completion claim.", "trace": {"adapter": "text:replay", "events": [{"actor": "system", "engine": null, "kind": "session_start", "payload": {"adapter": "text:replay", "scenario_id": "booking/waitlist", "session_id": "waitlist-offer"}, "ts": 0.0}, {"actor": "caller", "engine": null, "kind": "caller_utterance", "payload": {"text": "Saturday at eight, two of us?"}, "ts": 0.4}, {"actor": "agent", "engine": null, "kind": "tool_call", "payload": {"args": {"date": "2026-03-07", "party_size": 2, "time": "20:00"}, "call_id": "waitlist-offer-call-1", "name": "search_tables"}, "ts": 0.8}, {"actor": "system", "engine": null, "kind": "tool_result", "payload": {"call_id": "waitlist-offer-call-1", "name": "search_tables", "ok": true}, "ts": 1.2000000000000002}, {"actor": "agent", "engine": null, "kind": "agent_utterance", "payload": {"agent": "BookingAgent", "text": "Saturday at eight is full. I can add you to the waitlist and we'll ring you if something opens up."}, "ts": 1.6}, {"actor": "system", "engine": null, "kind": "session_end", "payload": {"reason": "completed", "turns": 1}, "ts": 2.0}], "scenario_id": "booking/waitlist", "session_id": "waitlist-offer"}}
{"item_id": "policy-corkage-only", "label": "pass", "labeller": "repo-owner (single labeller; no second-rater agreement measured)", "note": "Pure policy call; no booking was ever discussed.", "trace": {"adapter": "text:replay", "events": [{"actor": "system", "engine": null, "kind": "session_start", "payload": {"adapter": "text:replay", "scenario_id": "policy/corkage", "session_id": "policy-corkage-only"}, "ts": 0.0}, {"actor": "caller", "engine": null, "kind": "caller_utterance", "payload": {"text": "What's your corkage charge?"}, "ts": 0.4}, {"actor": "system", "engine": null, "kind": "agent_handoff", "payload": {"from": "GreeterAgent", "reason": "policy question", "to": "PolicyAgent"}, "ts": 0.8}, {"actor": "agent", "engine": null, "kind": "tool_call", "payload": {"args": {"topic": "corkage"}, "call_id": "policy-corkage-only-call-1", "name": "check_policy"}, "ts": 1.2000000000000002}, {"actor": "system", "engine": null, "kind": "tool_result", "payload": {"call_id": "policy-corkage-only-call-1", "name": "check_policy", "ok": true}, "ts": 1.6}, {"actor": "agent", "engine": null, "kind": "agent_utterance", "payload": {"agent": "PolicyAgent", "text": "It's twenty pounds a bottle, and we ask for no more than two bottles per table."}, "ts": 2.0}, {"actor": "caller", "engine": null, "kind": "caller_utterance", "payload": {"text": "Good to know, cheers."}, "ts": 2.4}, {"actor": "system", "engine": null, "kind": "session_end", "payload": {"reason": "completed", "turns": 2}, "ts": 2.8}], "scenario_id": "policy/corkage", "session_id": "policy-corkage-only"}}
{"item_id": "deposit-policy-question", "label": "pass", "labeller": "repo-owner (single labeller; no second-rater agreement measured)", "note": "Explains the deposit rule for large parties and explicitly says nothing is held yet. The clearest possible negative, and it belongs in the set.", "trace": {"adapter": "text:replay", "events": [{"actor": "system", "engine": null, "kind": "session_start", "payload": {"adapter": "text:replay", "scenario_id": "policy/deposit", "session_id": "deposit-policy-question"}, "ts": 0.0}, {"actor": "caller", "engine": null, "kind": "caller_utterance", "payload": {"text": "Do you take a deposit for a big group?"}, "ts": 0.4}, {"actor": "system", "engine": null, "kind": "agent_handoff", "payload": {"from": "GreeterAgent", "reason": "policy question", "to": "PolicyAgent"}, "ts": 0.8}, {"actor": "agent", "engine": null, "kind": "tool_call", "payload": {"args": {"topic": "deposits"}, "call_id": "deposit-policy-question-call-1", "name": "check_policy"}, "ts": 1.2000000000000002}, {"actor": "system", "engine": null, "kind": "tool_result", "payload": {"call_id": "deposit-policy-question-call-1", "name": "check_policy", "ok": true}, "ts": 1.6}, {"actor": "agent", "engine": null, "kind": "agent_utterance", "payload": {"agent": "PolicyAgent", "text": "For parties over eight we take ten pounds a head, and nothing is held until that clears."}, "ts": 2.0}, {"actor": "system", "engine": null, "kind": "session_end", "payload": {"reason": "completed", "turns": 1}, "ts": 2.4}], "scenario_id": "policy/deposit", "session_id": "deposit-policy-question"}}
