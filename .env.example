# Copy this file to `.env` and fill in only the keys you need.
#
#     cp .env.example .env
#
# `.env` is in .gitignore and has never been committed. This file is the only
# one of the pair that is tracked, which is the point: a person cloning this
# repository can see WHICH keys exist without ever seeing a value.
#
# ─────────────────────────────────────────────────────────────────────────────
# YOU DO NOT NEED ANY OF THESE TO RUN THIS REPOSITORY.
#
#     pip install -e ".[dev,report]"
#     make gate
#
# runs every test, every scenario, the recorded spoken call and the retrieval
# pack, with no key and no network. Every expensive path was run once and its
# output committed; everything since replays from those bytes.
#
# A test that needs a credential is a test that gets skipped, and a skipped test
# is not a verdict anybody can read. That is why the default is zero keys.
# ─────────────────────────────────────────────────────────────────────────────


# ── THE SWITCHES ─────────────────────────────────────────────────────────────
# Nothing below reaches a provider unless one of these is set to 1. They default
# to unset, and each refuses loudly rather than quietly replaying — a harness
# that silently falls back to a recording will one day tell you a live run passed
# when no live run happened.

# LAB_LIVE_SPOKEN=1       record a whole advisory call through real TTS and STT
# LAB_LIVE_TTS=1          synthesis only
# LAB_LIVE_STT=1          recognition only
# LAB_LIVE_TRAINEE=1      a real model in the trainee adviser's chair
# LAB_LIVE_CUSTOMER=1     a real model choosing the customer's words
# LAB_LIVE_SCORER=1       a real model behind the rubric
# LAB_LIVE_JUDGE=1        a real model behind a judge
# LAB_LIVE_TRANSPORT=1    live WebRTC rooms


# ── SPEECH ───────────────────────────────────────────────────────────────────
# Needed only by `make spoken-record`, which is the one command in this
# repository that spends money.

# ElevenLabs — text to speech.  https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Deepgram — speech to text.    https://console.deepgram.com/
DEEPGRAM_API_KEY=


# ── MODELS ───────────────────────────────────────────────────────────────────
# Needed only by the live trainee / customer / scorer / judge seats.
# Routes go through litellm, so any provider it supports works — set the route
# and the matching key.

OPENAI_API_KEY=

# Or Azure OpenAI, which is what the committed judge study used:
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21

# Which model plays which seat. Deliberately separate variables: the judge and
# the system under test must not be the same model, and `lab.judges.registry`
# refuses the pairing if they are.
# LAB_TRAINEE_MODEL=openai/gpt-4.1
# LAB_CUSTOMER_MODEL=openai/gpt-4.1
# LAB_SCORER_MODEL=openai/gpt-4.1
# LAB_LIVE_MODEL_LABEL=gpt-4.1


# ── COST GUARD ───────────────────────────────────────────────────────────────
# A character budget the spoken recorder refuses to exceed. There to make a
# runaway loop a stopped run rather than an invoice.
# LAB_SPOKEN_CHARACTER_CAP=3400
